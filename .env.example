# Copy to .env (never commit .env). See docs/ARCHITECTURE.md §11.
DJANGO_SECRET_KEY=change-me-in-prod
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
MONGODB_ATLAS_URI=mongodb+srv://educlip-app:<password>@cluster0.xxxx.mongodb.net/educlip?retryWrites=true&w=majority&tls=true
MONGODB_DB_NAME=educlip
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
YOUTUBE_API_KEY=
LLM_PROVIDER=gemini
OPENAI_API_KEY=
GEMINI_API_KEY=
SENTRY_DSN=
